rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    // Only a trusted Admin SDK pairing flow may create/revoke these grants.
    // A family contact/phone number is never an authorization grant.
    function caregiver(uid) {
      return signedIn() && exists(/databases/$(database)/documents/users/$(uid)/caregivers/$(request.auth.uid));
    }
    function validTask(d) {
      return d.keys().hasAll(['title', 'habitKey', 'hour', 'minute', 'repeat', 'status', 'remind'])
        && d.keys().hasOnly(['title', 'habitKey', 'hour', 'minute', 'repeat', 'status', 'remind'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 80
        && d.habitKey in ['move','purpose','downshift','eighty','plant','tea','belong','family','tribe']
        && d.hour is int && d.hour >= 0 && d.hour <= 23
        && d.minute is int && d.minute >= 0 && d.minute <= 59
        && d.repeat in ['once','daily','someDays']
        && d.status in ['pending','done','postponed','skipped']
        && d.remind is bool;
    }
    match /habits/{key} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /users/{uid} {
      allow read, create, update: if owner(uid);
      allow delete: if false;
      match /caregivers/{caregiverUid} {
        allow read: if owner(uid) || (signedIn() && request.auth.uid == caregiverUid);
        allow write: if false;
      }
      match /tasks/{id} {
        allow read: if owner(uid) || caregiver(uid);
        allow delete: if owner(uid);
        // Caregiver direct schedule writes await the agreed schedule contract.
        allow create, update: if owner(uid) && validTask(request.resource.data);
      }
      match /family/{id} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.keys().hasOnly(['name','relation','phone'])
          && request.resource.data.keys().hasAll(['name','relation','phone'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.relation is string && request.resource.data.relation.size() <= 40
          && request.resource.data.phone is string && request.resource.data.phone.size() <= 30;
      }
      match /devices/{tokenId} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.keys().hasAll(['token','updatedAt','platform'])
          && request.resource.data.keys().hasOnly(['token','updatedAt','platform'])
          && request.resource.data.token == tokenId
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.token.size() <= 4096
          && request.resource.data.platform == 'android'
          && request.resource.data.updatedAt == request.time;
      }
      match /notifications/{id} {
        allow read, delete: if owner(uid);
        allow create, update: if false;
      }
      // Proposed transport contract; UI integration requires team agreement.
      match /suggestions/{id} {
        allow read: if owner(uid) || (caregiver(uid) && resource.data.senderUid == request.auth.uid);
        allow create: if caregiver(uid)
          && request.resource.data.keys().hasOnly(['senderUid','status','title','createdAt'])
          && request.resource.data.keys().hasAll(['senderUid','status','title','createdAt'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80
          && request.resource.data.createdAt == request.time;
        allow update: if owner(uid) && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['accepted','rejected'];
        allow delete: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
