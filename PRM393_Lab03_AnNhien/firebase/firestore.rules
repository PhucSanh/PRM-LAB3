rules_version = '2';
// Chủ file: Hiếu. Mặc định chặn hết; mỗi người chỉ đọc/ghi dữ liệu của mình.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // 9 thói quen: ai đăng nhập cũng đọc được, không ai ghi từ app.
    match /habits/{key} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /users/{uid} {
      allow read, create, update: if isOwner(uid);
      allow delete: if false;

      match /tasks/{taskId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 80
          && request.resource.data.hour is int
          && request.resource.data.hour >= 0 && request.resource.data.hour <= 23;
      }
      match /family/{personId} { allow read, write: if isOwner(uid); }
      match /notifications/{id} { allow read, write: if isOwner(uid); }
      match /suggestions/{id} { allow read, update: if isOwner(uid); }
    }

    match /{document=**} { allow read, write: if false; }
  }
}
