FROM node:22-bookworm-slim
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000 USE_FIREBASE_CLI_CREDENTIAL=0
WORKDIR /app
COPY firebase/functions/package.json firebase/functions/package-lock.json ./firebase/functions/
RUN npm ci --omit=dev --ignore-scripts --prefix firebase/functions && npm cache clean --force
COPY --chown=node:node firebase/functions/*.cjs ./firebase/functions/
COPY --chown=node:node admin-web/*.html admin-web/*.css admin-web/*.js ./admin-web/
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s CMD node -e "fetch('http://127.0.0.1:3000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "firebase/functions/real-server.cjs"]
